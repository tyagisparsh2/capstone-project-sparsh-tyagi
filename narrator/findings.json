import json
from matplotlib import Path

# These values must come from calculations already performed

findings = {
    "cleaned_total_revenue_inr": round(cleaned_total_revenue, 2),
    "raw_total_revenue_inr": round(raw_total_revenue, 2),
    "duplicate_reconciliation_delta_inr": round(
        raw_total_revenue - cleaned_total_revenue, 2
    ),

    "return_rate_by_payment": {
        "COD": round(return_rates["COD"], 1),
        "CARD": round(return_rates["CARD"], 1),
        "UPI": round(return_rates["UPI"], 1)
    },

    "highest_risk_segment": {
        "payment_method": highest_risk_segment["payment_method"],
        "city_tier": int(highest_risk_segment["city_tier"]),
        "return_rate_pct": round(
            highest_risk_segment["return_rate_pct"], 1
        )
    },

    "true_peak_month": {
        "month": true_peak_month["month"],
        "revenue_inr": round(true_peak_month["revenue_inr"], 2)
    },

    "outlier_inflated_month": {
        "month": outlier_inflated_month["month"],
        "apparent_revenue_inr": round(
            outlier_inflated_month["apparent_revenue_inr"], 2
        ),
        "corrected_revenue_inr": round(
            outlier_inflated_month["corrected_revenue_inr"], 2
        )
    }
}

# Create narrator folder if it does not already exist
narrator_dir = Path("narrator")
narrator_dir.mkdir(parents=True, exist_ok=True)

# Write structured JSON
output_file = output_dir / "findings.json"

with open(output_file, "w", encoding="utf-8") as f:
    json.dump(findings, f, indent=2)

print(f"\nVerified findings exported to: {output_file}")
print(json.dumps(findings, indent=2))



