# ============================================================
# TASK 5 — Export verified findings for the GenAI narrator
# ============================================================

import json
from pathlib import Path

# These values should come from calculations already performed above
# in this script — not manually entered.

cleaned_total_revenue = order_value.sum()
raw_total_revenue = raw_order_value.sum()
duplicate_reconciliation_delta = raw_total_revenue - cleaned_total_revenue

# Return rate by payment method
payment_return_rates = (
    orders_cleaned.groupby("payment_method")["returned"]
    .mean()
    .mul(100)
    .round(1)
    .to_dict()
)

# Highest-risk payment/city-tier segment
segment_rates = (
    orders_cleaned
    .groupby(["payment_method", "city_tier"])["returned"]
    .mean()
    .mul(100)
    .round(1)
)

highest_risk_segment_key = segment_rates.idxmax()

highest_risk_segment = {
    "payment_method": highest_risk_segment_key[0],
    "city_tier": int(highest_risk_segment_key[1]),
    "return_rate_pct": float(segment_rates.max())
}

# Monthly revenue
monthly_revenue = (
    orders_cleaned
    .groupby(orders_cleaned["order_date"].dt.to_period("M"))["order_value"]
    .sum()
)

true_peak_period = monthly_revenue.idxmax()

true_peak_month = {
    "month": str(true_peak_period),
    "revenue_inr": round(float(monthly_revenue.max()), 2)
}

# Outlier-inflated January revenue
# O0011 and O0098 are the two quantity outliers identified by the IQR rule.
january_orders = orders_cleaned[
    orders_cleaned["order_date"].dt.to_period("M") == "2026-01"
]

apparent_january_revenue = january_orders["order_value"].sum()

january_without_outliers = january_orders[
    ~january_orders["order_id"].isin(["O0011", "O0098"])
]

corrected_january_revenue = january_without_outliers["order_value"].sum()

outlier_inflated_month = {
    "month": "2026-01",
    "apparent_revenue_inr": round(float(apparent_january_revenue), 2),
    "corrected_revenue_inr": round(float(corrected_january_revenue), 2)
}

# Final structured findings object
findings = {
    "cleaned_total_revenue_inr": round(float(cleaned_total_revenue), 2),
    "raw_total_revenue_inr": round(float(raw_total_revenue), 2),
    "duplicate_reconciliation_delta_inr": round(
        float(duplicate_reconciliation_delta), 2
    ),
    "return_rate_by_payment": {
        key: float(value)
        for key, value in payment_return_rates.items()
    },
    "highest_risk_segment": highest_risk_segment,
    "true_peak_month": true_peak_month,
    "outlier_inflated_month": outlier_inflated_month
}

# Create narrator folder if it does not exist
narrator_dir = Path("narrator")
narrator_dir.mkdir(exist_ok=True)

# Write the verified findings
findings_path = narrator_dir / "findings.json"

with open(findings_path, "w", encoding="utf-8") as f:
    json.dump(findings, f, indent=2)

print("\nVerified findings exported to:", findings_path)
print(json.dumps(findings, indent=2))






